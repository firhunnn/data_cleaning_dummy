-- Create Proper Case Function
DELIMITER $$
CREATE FUNCTION ProperCase(str TEXT)
RETURNS TEXT
DETERMINISTIC
BEGIN
    DECLARE c CHAR(1);                             -- Current character
    DECLARE s TEXT;                                -- Modified string
    DECLARE i INT DEFAULT 1;                       -- Position index
    DECLARE bool INT DEFAULT 1;                    -- Flag to check word start
    DECLARE punct CHAR(17) DEFAULT ' ()[]{},.-_!@;:?/';  -- Word separators
    SET s = LOWER(str);                            -- Convert input to lowercase
    WHILE i <= CHAR_LENGTH(s) DO
        SET c = SUBSTRING(s, i, 1);                -- Get each character
        IF LOCATE(c, punct) > 0 THEN
            SET bool = 1;                          -- Next char is start of a word
        ELSEIF bool = 1 THEN
            SET s = CONCAT(
                LEFT(s, i - 1),
                UPPER(c),
                SUBSTRING(s, i + 1)
            );
            SET bool = 0;                          -- Reset flag after capitalizing
        END IF;
        SET i = i + 1;
    END WHILE;
    RETURN s;
END$$
DELIMITER ;

