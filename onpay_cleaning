-- Delimit any line feed into single line
WITH RECURSIVE product_split AS (
    SELECT id,created_at, sale_status, form_code, form_title, invoice_number, donor_name, email, phone_number, product, total_quantity, 
           SUBSTRING_INDEX(product, '\n', 1) AS single_product,
           IF(LOCATE('\n', product) > 0, SUBSTRING(product, LOCATE('\n', product) + 1), '') AS remaining
    FROM onpay_2026
    UNION ALL
    SELECT id,created_at, sale_status, form_code, form_title, invoice_number, donor_name, email, phone_number, product, total_quantity, 
           SUBSTRING_INDEX(remaining, '\n', 1),
           IF(LOCATE('\n', remaining) > 0, SUBSTRING(remaining, LOCATE('\n', remaining) + 1), '')
    FROM product_split
    WHERE remaining <> ''
)
SELECT cast(id as unsigned) as id, created_at, sale_status, form_code, form_title, invoice_number, donor_name, email, phone_number, product, total_quantity, TRIM(single_product) AS product_item
FROM product_split
ORDER BY id;

