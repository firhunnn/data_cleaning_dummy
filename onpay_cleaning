add column fixed_phone_number int;

-- Populate fixed_phone_number with query above
Start transaction;
Update onpayt_2026
set fixed_phone_number = 
    case
		when length(phone_number) <= 10 then null
        when phone_number like '%123456%' then null
        when phone_number like '%0000%' then null
        when phone_number like '%11111%' then null
        when phone_number regexp '^6001[^1]' then concat(6, substring(phone_number, 3, 12))
		When phone_number like '6011%' and length(phone_number) = 11 then null
        When phone_number not like '6011%' and length(phone_number) = 12 then null
        when phone_number regexp '^6001[^1]' then concat(6, substring(phone_number, 3, 12))
        when phone_number like '60011%' and length(phone_number) = 13 then concat(6, substring(phone_number, 3, 12))
        when phone_number not like '60011%' and length(phone_number) = 12 then concat(60, substring(phone_number, 3, 12))
        when phone_number not like '60011%' and length(phone_number) = 12 then concat(60, substring(phone_number, 2, 12))
        when phone_number not like '601%' and length(phone_number) <= 12  then null
        when length(phone_number) >= 13 then null
        else phone_number
	end;
Rollback;
Commit;

-- End of data cleaning for onpayt_2026
